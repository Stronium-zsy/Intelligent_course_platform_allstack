{"remainingRequest":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/babel-loader/lib/index.js!/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/cache-loader/dist/cjs.js??ref--0-0!/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/src/views/system/video/videoPlayer.vue?vue&type=script&lang=js","dependencies":[{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/src/views/system/video/videoPlayer.vue","mtime":1734421243643},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/babel.config.js","mtime":1734421243495},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/cache-loader/dist/cjs.js","mtime":1734421685851},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/babel-loader/lib/index.js","mtime":1734421689101},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/cache-loader/dist/cjs.js","mtime":1734421685851},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/vue-loader/lib/index.js","mtime":1734421691774}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["_hls","_interopRequireDefault","require","_videos","_ruoyi","name","data","queryParams","pageNum","pageSize","courseName","teacherName","classTime","videosList","total","loading","currentVideo","lastCapturedTime","created","getList","methods","parseTime","_this","listVideos","then","response","rows","handleQuery","resetQuery","handleRowClick","row","_this2","$nextTick","video","$refs","videoUrl","videoPath","Hls","isSupported","hls","attachMedia","loadSource","canPlayType","src","addEventListener","play","captureAudio"],"sources":["src/views/system/video/videoPlayer.vue"],"sourcesContent":["<template>\n  <div class=\"app-container\">\n    <!-- 搜索和课程列表 -->\n    <el-row class=\"search-section\" gutter=\"20\">\n      <el-col :span=\"24\">\n        <el-form\n          :model=\"queryParams\"\n          ref=\"queryForm\"\n          size=\"small\"\n          :inline=\"true\"\n          label-width=\"68px\"\n        >\n          <el-form-item label=\"课程名称\">\n            <el-input\n              v-model=\"queryParams.courseName\"\n              placeholder=\"请输入课程名称\"\n              clearable\n              @keyup.enter.native=\"handleQuery\"\n            />\n          </el-form-item>\n          <el-form-item label=\"教师名称\">\n            <el-input\n              v-model=\"queryParams.teacherName\"\n              placeholder=\"请输入教师名称\"\n              clearable\n              @keyup.enter.native=\"handleQuery\"\n            />\n          </el-form-item>\n          <el-form-item label=\"时间\">\n            <el-date-picker\n              v-model=\"queryParams.classTime\"\n              type=\"date\"\n              value-format=\"yyyy-MM-dd\"\n              placeholder=\"请选择时间\"\n              clearable\n            />\n          </el-form-item>\n          <el-form-item>\n            <el-button\n              type=\"primary\"\n              icon=\"el-icon-search\"\n              size=\"mini\"\n              @click=\"handleQuery\"\n            >\n              搜索\n            </el-button>\n            <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">\n              重置\n            </el-button>\n          </el-form-item>\n        </el-form>\n      </el-col>\n    </el-row>\n\n    <el-row class=\"video-list-section\" gutter=\"20\">\n      <el-col :span=\"24\">\n        <el-table\n          v-loading=\"loading\"\n          :data=\"videosList\"\n          border\n          @row-click=\"handleRowClick\"\n          highlight-current-row\n        >\n          <el-table-column type=\"index\" width=\"50\" align=\"center\" label=\"序号\" />\n          <el-table-column prop=\"courseName\" label=\"课程名称\" align=\"center\" />\n          <el-table-column prop=\"teacherName\" label=\"教师名称\" align=\"center\" />\n          <el-table-column\n            prop=\"classTime\"\n            label=\"课程时间\"\n            align=\"center\"\n            width=\"180\"\n          >\n            <template #default=\"scope\">\n              <span>{{ parseTime(scope.row.classTime, '{y}-{m}-{d}') }}</span>\n            </template>\n          </el-table-column>\n        </el-table>\n        <!-- 分页 -->\n        <pagination\n          v-show=\"total > 0\"\n          :total=\"total\"\n          :page.sync=\"queryParams.pageNum\"\n          :limit.sync=\"queryParams.pageSize\"\n          @pagination=\"getList\"\n        />\n      </el-col>\n    </el-row>\n\n    <el-row class=\"video-player-section\" gutter=\"20\">\n      <el-col :span=\"24\">\n        <div v-if=\"currentVideo\" class=\"video-player\">\n          <h2 class=\"compact\">当前播放：{{ currentVideo.courseName }}</h2>\n          <p class=\"compact\"><strong>教师：</strong>{{ currentVideo.teacherName }}</p>\n          <p class=\"compact\"><strong>时间：</strong>{{ parseTime(currentVideo.classTime, '{y}-{m}-{d}') }}</p>\n          <video\n            ref=\"video\"\n            controls\n            width=\"100%\"\n            height=\"auto\"\n            @timeupdate=\"captureAudio\"\n          ></video>\n        </div>\n        <div v-else class=\"no-video\">\n          <h2>请选择课程进行播放</h2>\n        </div>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport Hls from \"hls.js\";\nimport { listVideos } from \"@/api/system/videos\";\nimport { parseTime } from \"@/utils/ruoyi\";\n\nexport default {\n  name: \"videoPlayer\",\n  data() {\n    return {\n      queryParams: {\n        pageNum: 1,\n        pageSize: 10,\n        courseName: \"\",\n        teacherName: \"\",\n        classTime: \"\",\n      },\n      videosList: [],\n      total: 0,\n      loading: false,\n      currentVideo: null,\n      lastCapturedTime: 0, // 上次提取的时间点\n    };\n  },\n  created() {\n    this.getList();\n  },\n  methods: {\n    parseTime,\n    getList() {\n      this.loading = true;\n      listVideos(this.queryParams).then((response) => {\n        this.videosList = response.rows;\n        this.total = response.total;\n        this.loading = false;\n      });\n    },\n    handleQuery() {\n      this.queryParams.pageNum = 1;\n      this.getList();\n    },\n    resetQuery() {\n      this.queryParams = {\n        pageNum: 1,\n        pageSize: 10,\n        courseName: \"\",\n        teacherName: \"\",\n        classTime: \"\",\n      };\n      this.handleQuery();\n    },\n    handleRowClick(row) {\n      this.currentVideo = row;\n      this.$nextTick(() => {\n        const video = this.$refs.video;\n        const videoUrl = row.videoPath;\n        if (Hls.isSupported()) {\n          const hls = new Hls();\n          hls.attachMedia(video);\n          hls.loadSource(videoUrl);\n        } else if (video.canPlayType(\"application/vnd.apple.mpegurl\")) {\n          video.src = videoUrl;\n          video.addEventListener(\"canplay\", () => video.play());\n        }\n      });\n    },\n    captureAudio() {\n      // captureAudio implementation\n    },\n  },\n};\n</script>\n\n<style scoped>\n.app-container {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  width: 90%;\n}\n\n.search-section,\n.video-list-section,\n.video-player-section {\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.video-player {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.no-video {\n  text-align: center;\n  color: #888;\n}\n\n.compact {\n  margin: 5px 0;\n  line-height: 1.2;\n}\n</style>\n"],"mappings":";;;;;;;AA+GA,IAAAA,IAAA,GAAAC,sBAAA,CAAAC,OAAA;AACA,IAAAC,OAAA,GAAAD,OAAA;AACA,IAAAE,MAAA,GAAAF,OAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;iCAEA;EACAG,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,WAAA;QACAC,OAAA;QACAC,QAAA;QAC