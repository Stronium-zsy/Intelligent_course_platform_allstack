{"remainingRequest":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/babel-loader/lib/index.js!/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/cache-loader/dist/cjs.js??ref--0-0!/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/src/views/system/favorites/index.vue?vue&type=script&lang=js","dependencies":[{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/src/views/system/favorites/index.vue","mtime":1734421243641},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/babel.config.js","mtime":1734421243495},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/cache-loader/dist/cjs.js","mtime":1734421685851},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/babel-loader/lib/index.js","mtime":1734421689101},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/cache-loader/dist/cjs.js","mtime":1734421685851},{"path":"/home/trm/project/Intelligent_course_platform_allstack/ruoyi-ui/node_modules/vue-loader/lib/index.js","mtime":1734421691774}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["_favorites","require","name","data","loading","favoritesList","total","queryParams","pageNum","pageSize","userName","favoriteTime","ids","multiple","isSearching","created","getInitialList","methods","_this","userId","$store","state","user","id","listFavorites","then","response","rows","getList","_this2","listFavoritesByCriteria","handleQuery","$message","error","resetQuery","handleSelectionChange","selection","map","item","favoriteId","length","handleDelete","row","_this3","favoriteIds","$modal","confirm","delFavorites","msgSuccess","viewPostDetail","postId","$router","push","params"],"sources":["src/views/system/favorites/index.vue"],"sourcesContent":["<template>\n  <div class=\"app-container\">\n    <!-- 查询条件表单 -->\n    <el-form :model=\"queryParams\" ref=\"queryForm\" size=\"small\" :inline=\"true\" label-width=\"80px\">\n      <el-form-item label=\"用户名\" prop=\"userName\">\n        <el-input\n          v-model=\"queryParams.userName\"\n          placeholder=\"请输入用户名\"\n          clearable\n        />\n      </el-form-item>\n      <el-form-item label=\"收藏时间\" prop=\"favoriteTime\">\n        <el-date-picker\n          clearable\n          v-model=\"queryParams.favoriteTime\"\n          type=\"date\"\n          value-format=\"yyyy-MM-dd\"\n          placeholder=\"请选择收藏时间\"\n        ></el-date-picker>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\n        <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\n      </el-form-item>\n    </el-form>\n\n    <el-row :gutter=\"10\" class=\"mb8\">\n      <el-col :span=\"1.5\">\n        <el-button\n          type=\"danger\"\n          plain\n          icon=\"el-icon-delete\"\n          size=\"mini\"\n          :disabled=\"multiple\"\n          @click=\"handleDelete\"\n          v-hasPermi=\"['system:favorites:remove']\"\n        >删除</el-button>\n      </el-col>\n    </el-row>\n\n    <!-- 收藏列表表格 -->\n    <el-table v-loading=\"loading\" :data=\"favoritesList\" @selection-change=\"handleSelectionChange\">\n      <el-table-column type=\"selection\" width=\"55\" align=\"center\" />\n      <el-table-column label=\"用户名\" align=\"center\" prop=\"userName\" />\n      <el-table-column label=\"帖子标题\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-link type=\"primary\" @click=\"viewPostDetail(scope.row.postId)\">\n            {{ scope.row.postTitle || '无标题' }}\n          </el-link>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"收藏时间\" align=\"center\" prop=\"favoriteTime\" width=\"180\">\n        <template slot-scope=\"scope\">\n          <span>{{ parseTime(scope.row.favoriteTime, '{y}-{m}-{d}') }}</span>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"操作\" align=\"center\" class-name=\"small-padding fixed-width\">\n        <template slot-scope=\"scope\">\n          <el-button\n            size=\"mini\"\n            type=\"text\"\n            icon=\"el-icon-delete\"\n            @click=\"handleDelete(scope.row)\"\n            v-hasPermi=\"['system:favorites:remove']\"\n          >删除</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <pagination\n      v-show=\"total > 0\"\n      :total=\"total\"\n      :page.sync=\"queryParams.pageNum\"\n      :limit.sync=\"queryParams.pageSize\"\n      @pagination=\"getList\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listFavoritesByCriteria, listFavorites, delFavorites } from \"@/api/system/favorites\";\n\nexport default {\n  name: \"Favorites\",\n  data() {\n    return {\n      loading: false,\n      favoritesList: [],\n      total: 0,\n      queryParams: {\n        pageNum: 1,\n        pageSize: 10,\n        userName: '',\n        favoriteTime: null,\n      },\n      ids: [],\n      multiple: true,\n      isSearching: false, // 区分是否在执行搜索操作\n    };\n  },\n  created() {\n    this.getInitialList();\n  },\n  methods: {\n    /** 获取初始收藏列表，仅加载当前用户的收藏 */\n    getInitialList() {\n      this.loading = true;\n      const userId = this.$store.state.user.id; // 当前登录用户ID\n      listFavorites({ userId, pageNum: this.queryParams.pageNum, pageSize: this.queryParams.pageSize }).then((response) => {\n        this.favoritesList = response.rows;\n        this.total = response.total;\n        this.loading = false;\n        this.isSearching = false; // 标记非搜索状态\n      });\n    },\n    /** 查询收藏列表（支持用户名或时间条件） */\n    getList() {\n      this.loading = true;\n      listFavoritesByCriteria(this.queryParams).then((response) => {\n        this.favoritesList = response.rows;\n        this.total = response.total;\n        this.loading = false;\n        this.isSearching = true; // 标记为搜索状态\n      });\n    },\n    /** 搜索按钮操作 */\n    handleQuery() {\n      if (this.queryParams.favoriteTime && !this.queryParams.userName) {\n        this.$message.error('请输入用户名后再按日期查询');\n        return;\n      }\n      this.queryParams.pageNum = 1;\n      this.getList();\n    },\n    /** 重置查询条件 */\n    resetQuery() {\n      this.queryParams = {\n        pageNum: 1,\n        pageSize: 10,\n        userName: '',\n        favoriteTime: null,\n      };\n      this.getInitialList(); // 重置时回到初始收藏列表\n    },\n    /** 处理多选框选择事件 */\n    handleSelectionChange(selection) {\n      this.ids = selection.map((item) => item.favoriteId);\n      this.multiple = !this.ids.length;\n    },\n    /** 删除收藏记录 */\n    handleDelete(row) {\n      const favoriteIds = row ? [row.favoriteId] : this.ids;\n      this.$modal.confirm('是否确认删除选中的收藏记录？').then(() => {\n        return delFavorites(favoriteIds);\n      }).then(() => {\n        if (this.isSearching) {\n          this.getList(); // 搜索状态时刷新搜索结果\n        } else {\n          this.getInitialList(); // 非搜索状态时刷新初始列表\n        }\n        this.$modal.msgSuccess(\"删除成功\");\n      });\n    },\n    /** 查看帖子详情 */\n    viewPostDetail(postId) {\n      if (!postId) {\n        this.$message.error('帖子不存在');\n        return;\n      }\n      this.$router.push({name: 'PostDetail', params: {postId}});\n    },\n  },\n};\n</script>\n\n<style scoped>\n.app-container {\n  padding: 20px;\n}\n\n.mb8 {\n  margin-bottom: 8px;\n}\n</style>\n"],"mappings":";;;;;;;;;AAgFA,IAAAA,UAAA,GAAAC,OAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;iCAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,aAAA;MACAC,KAAA;MACAC,WAAA;QACAC,OAAA;QACAC,QAAA;QACAC,QAAA;QACAC,YAAA;MACA;MACAC,GAAA;MACAC,QAAA;MACAC,WAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,0BACAD,cAAA,WA