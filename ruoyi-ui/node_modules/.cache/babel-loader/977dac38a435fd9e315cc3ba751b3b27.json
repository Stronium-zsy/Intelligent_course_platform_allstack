lendar.vue\",\n  components: { PdfViewer },\n  data() {\n    return {\n      customUploadPath: '/system/material/uploadMaterial',\n      pdfPath: \"\",\n      uploadParams: {},\n      configList: [],\n      total: 0\n    };\n  },\n  methods: {\n    getPath() {\n      listMaterial({\n        courseId: this.$route.params.courseId,\n        materialType: \"courseCalendar\"\n      }).then((response) => {\n        this.configList = response.rows || []; // 确保 rows 存在\n        this.total = response.total || 0;\n\n        // 如果 configList 有内容，则设置 pdfPath\n        if (this.configList.length > 0) {\n          this.pdfPath = this.configList[0].filePath;\n          console.log(\"PDF Path:\", this.pdfPath);\n        } else {\n          console.warn(\"No material found for the specified course and material type.\");\n        }\n\n        // 使用一个新的对象替换 uploadParams\n        this.uploadParams = {\n          courseId: this.$route.params.courseId,\n          materialType: \"courseCalendar\"\n        };\n      }).catch((error) => {\n        console.error(\"Error loading material:\", error);\n      });\n    }\n  },\n  created() {\n    this.getPath();\n  }\n};\n</script>\n\n<template>\n  <div>\n    <PdfViewer v-if=\"pdfPath\" :pdf-path=\"pdfPath\" />\n    <FileUpload\n      :uploadPath=\"customUploadPath\"\n      :upload-params=\"uploadParams\"\n      v-has-permi=\"['system:material:add']\"\n    />\n  </div>\n</template>\n\n\n"],"mappings":";;;;;;;AACA,IAAAA,IAAA,GAAAC,sBAAA,CAAAC,OAAA;AACA,IAAAC,SAAA,GAAAD,OAAA;AAAA,IAAAE,QAAA,GAAAC,OAAA,CAAAC,OAAA,GAEA;EACAC,IAAA;EACAC,UAAA;IAAAC,SAAA,EAAAA;EAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,gBAAA;MACAC,OAAA;MACAC,YAAA;MACAC,UAAA;MACAC,KAAA;IACA;EACA;EACAC,OAAA;IACAC,OAAA,WAAAA,QAAA;MAAA,IAAAC,KAAA;MACA,IAAAC,sBAAA;QACAC,QAAA,OAAAC,MAAA,CAAAC,MAAA,CAAAF,QAAA;QACAG,YAAA;MACA,GAAAC,IAAA,WAAAC,QAAA;QACAP,KAAA,CAAAJ,UAAA,GAAAW,QAAA,CAAAC,IAAA;QACAR,KAAA,CAAAH,KAAA,GAAAU,QAAA,CAAAV,KAAA;;QAEA;QACA,IAAAG,KAAA,CAAAJ,UAAA,CAAAa,MAAA;UACAT,KAAA,CAAAN,OAAA,G