<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DiscussionMessageMapper">
    
    <resultMap type="DiscussionMessage" id="DiscussionMessageResult">
        <result property="messageId"    column="message_id"    />
        <result property="courseId"    column="course_id"    />
        <result property="userId"    column="user_id"    />
        <result property="messageDetail"    column="message_detail"    />
        <result property="messageType"    column="message_type"    />
        <result property="createdTime"    column="created_time"    />
        <result property="userName"      column="user_name"/>
    </resultMap>

    <sql id="selectDiscussionMessageVo">
        select message_id, course_id, user_id, message_detail, message_type, created_time,user_name from discussion_message
    </sql>

    <select id="selectDiscussionMessageList" parameterType="DiscussionMessage" resultMap="DiscussionMessageResult">
        <include refid="selectDiscussionMessageVo"/>
        <where>  
            <if test="courseId != null "> and course_id = #{courseId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="messageDetail != null  and messageDetail != ''"> and message_detail = #{messageDetail}</if>
            <if test="messageType != null  and messageType != ''"> and message_type = #{messageType}</if>
            <if test="createdTime != null "> and created_time = #{createdTime}</if>
             <if test="userName !=null">and user_name = #{userName}</if>
        </where>
    </select>
    
    <select id="selectDiscussionMessageByMessageId" parameterType="Long" resultMap="DiscussionMessageResult">
        <include refid="selectDiscussionMessageVo"/>
        where message_id = #{messageId}
    </select>

    <insert id="insertDiscussionMessage" parameterType="DiscussionMessage" useGeneratedKeys="true" keyProperty="messageId">
        insert into discussion_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="courseId != null">course_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="messageDetail != null">message_detail,</if>
            <if test="messageType != null">message_type,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="userName != null">user_name,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="courseId != null">#{courseId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="messageDetail != null">#{messageDetail},</if>
            <if test="messageType != null">#{messageType},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="userName!=null">#{userName},</if>
         </trim>
    </insert>

    <update id="updateDiscussionMessage" parameterType="DiscussionMessage">
        update discussion_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="courseId != null">course_id = #{courseId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="messageDetail != null">message_detail = #{messageDetail},</if>
            <if test="messageType != null">message_type = #{messageType},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
        </trim>
        where message_id = #{messageId}
    </update>

    <delete id="deleteDiscussionMessageByMessageId" parameterType="Long">
        delete from discussion_message where message_id = #{messageId}
    </delete>

    <delete id="deleteDiscussionMessageByMessageIds" parameterType="String">
        delete from discussion_message where message_id in 
        <foreach item="messageId" collection="array" open="(" separator="," close=")">
            #{messageId}
        </foreach>
    </delete>
</mapper>